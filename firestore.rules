rules_version = '2';

// Reglas de seguridad de Re-crea: muro de opiniones + cuentas de usuario.
// Se pegan en: Firebase consola -> Firestore Database -> pestaña "Reglas" -> Publicar.
//
// Qué permiten:
//  - Cualquier persona puede LEER solo las opiniones aprobadas (approved == true).
//  - Cualquier persona puede CREAR una opinión, pero siempre queda "pendiente" (approved == false)
//    y con límites de largo. Ustedes la aprueban cambiando approved a true en la consola.
//  - Nadie puede editar ni borrar desde la página web.
//
// Cuentas (colección "usuarios", un documento por persona con el mismo id de Firebase Authentication):
//  - Cada persona solo puede leer, crear, modificar y borrar SU PROPIO documento.
//  - El nombre de usuario y la fecha de creación no se pueden cambiar después.
//  - El plan es solo una etiqueta de simulación: no hay pagos reales detrás.
service cloud.firestore {
  match /databases/{database}/documents {
    match /opiniones/{id} {
      allow read: if resource.data.approved == true;

      allow create: if request.resource.data.keys().hasOnly(['nombre', 'categoria', 'mensaje', 'fecha', 'approved'])
        && request.resource.data.approved == false
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 40
        && request.resource.data.categoria in ['Reducir', 'Reutilizar', 'Reciclar', 'Compostar', 'Otra idea']
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 5 && request.resource.data.mensaje.size() <= 500
        && request.resource.data.fecha == request.time;

      allow update, delete: if false;
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['usuario', 'plan', 'perfilId', 'vivienda', 'codigo', 'fecha', 'progreso'])
        && request.resource.data.usuario is string
        && request.resource.data.usuario.size() >= 3 && request.resource.data.usuario.size() <= 20
        && request.resource.data.plan in ['gratis', 'mensual', 'anual']
        && request.resource.data.vivienda in ['casa', 'depto']
        && request.resource.data.perfilId is string && request.resource.data.perfilId.size() <= 20
        && request.resource.data.progreso is map;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['usuario', 'plan', 'perfilId', 'vivienda', 'codigo', 'fecha', 'progreso'])
        && request.resource.data.usuario == resource.data.usuario
        && request.resource.data.fecha == resource.data.fecha
        && request.resource.data.codigo == resource.data.codigo
        && request.resource.data.plan in ['gratis', 'mensual', 'anual']
        && request.resource.data.vivienda in ['casa', 'depto']
        && request.resource.data.progreso is map;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
